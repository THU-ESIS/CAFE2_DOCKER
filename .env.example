# Copy this file to .env and adjust paths/values for the deployment.

# Required for Local/Worker. This directory is mounted read-only as /CAFE_DATA.
CAFE_DATA_HOST=./data

# Ports exposed on the host.
PORTAL_HTTP_PORT=4000
CENTRAL_HTTP_PORT=8081
WORKER_HTTP_PORT=8082
LOCAL_HTTP_PORT=8083

# Portal-to-node URL. Use the Docker service name only for same-project tests.
CAFE_PORTAL_CAFE_WORKER_URL=http://local:8080/datamanager

# Image mode: replace these with published immutable images.
# Example:
# CAFE2_PORTAL_IMAGE=ghcr.io/your-org/cafe2-portal:v1.11.0
# CAFE2_CENTRAL_IMAGE=ghcr.io/your-org/cafe2-central:v1.11.0
# CAFE2_WORKER_IMAGE=ghcr.io/your-org/cafe2-worker:v1.11.0
# CAFE2_LOCAL_IMAGE=ghcr.io/your-org/cafe2-local:v1.11.0
